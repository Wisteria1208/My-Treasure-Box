# 复制本文件为 .env（去掉 .example），把 token 换成你自己的
# 获取地址：https://replicate.com/account/api-tokens
#
# 注意：.env 里放的是密钥，不要提交到 GitHub、不要发给别人。
# 本项目已默认忽略以点开头的文件，不会被后端当成静态资源对外暴露。

REPLICATE_API_TOKEN=r8_在这里粘贴你的token

# ---------- 以下都是可选项，不填就用默认值 ----------

# 监听端口，默认 5173
# PORT=5173

# 监听地址，默认 127.0.0.1（只允许本机访问，更安全）
# HOST=127.0.0.1

# 使用的模型，默认 lucataco/remove-bg
# REPLICATE_MODEL=lucataco/remove-bg

# 模型版本号。一般不用填：服务启动时会自动读取该模型的最新版本。
# 只有在「模型已更新但你想锁定旧版」或解析失败时，才需要手动指定。
# REPLICATE_MODEL_VERSION=95fcc2a26d3899cd6c2691c900465aaeff466285a65c14638cc5f36f34befaf1

# 单次上传体积上限（MB），默认 12
# MAX_UPLOAD_MB=12
